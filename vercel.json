{
  "redirects": [
    {
      "source": "/a",
      "destination": "https://venmo.com/SideQuestVote?txn=pay&note=SIDE-A_Q001",
      "statusCode": 302
    },
    {
      "source": "/b",
      "destination": "https://venmo.com/SideQuestVote?txn=pay&note=SIDE-B_Q001",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quest",
      "destination": "/quest.html"
    }
  ]
}
